      "policies": {},
      "checkConstraints": {
        "predictions_status_check": {
          "name": "predictions_status_check",
          "value": "\"predictions\".\"status\" in ('open', 'won', 'lost', 'tie', 'void')"
        },
        "predictions_direction_check": {
          "name": "predictions_direction_check",
          "value": "\"predictions\".\"direction\" in ('UP', 'DOWN')"
        },
        "predictions_duration_check": {
          "name": "predictions_duration_check",
          "value": "\"predictions\".\"duration_sec\" in (30, 60, 180, 300)"
        },
        "predictions_game_mode_check": {
          "name": "predictions_game_mode_check",
          "value": "\"predictions\".\"game_mode\" in ('classic')"
        },
        "predictions_stake_check": {
          "name": "predictions_stake_check",
          "value": "\"predictions\".\"stake\" > 0"
        },
        "predictions_payout_bps_check": {
          "name": "predictions_payout_bps_check",
          "value": "\"predictions\".\"payout_bps\" between 1 and 10000"
        },
        "predictions_expiry_check": {
          "name": "predictions_expiry_check",
          "value": "\"predictions\".\"expires_at\" = \"predictions\".\"opened_at\" + \"predictions\".\"duration_sec\" * interval '1 second'"
        },
        "predictions_entry_time_check": {
          "name": "predictions_entry_time_check",
          "value": "\"predictions\".\"entry_received_at\" <= \"predictions\".\"opened_at\""
        },
        "predictions_open_shape_check": {
          "name": "predictions_open_shape_check",
          "value": "(\"predictions\".\"status\" = 'open') = (\"predictions\".\"settled_at\" is null)\n        and (\"predictions\".\"status\" = 'open') = (\"predictions\".\"payout_amount\" is null)\n        and (\"predictions\".\"status\" = 'void') = (\"predictions\".\"void_reason\" is not null)\n        and (\"predictions\".\"status\" in ('won', 'lost', 'tie')) = (\"predictions\".\"exit_price\" is not null)"
        },
        "predictions_outcome_check": {
          "name": "predictions_outcome_check",
          "value": "\"predictions\".\"status\" not in ('won', 'lost', 'tie') or (\n        (\"predictions\".\"status\" = 'tie' and \"predictions\".\"exit_price\" = \"predictions\".\"entry_price\")\n        or (\"predictions\".\"status\" = 'won' and ((\"predictions\".\"direction\" = 'UP' and \"predictions\".\"exit_price\" > \"predictions\".\"entry_price\")\n                                  or (\"predictions\".\"direction\" = 'DOWN' and \"predictions\".\"exit_price\" < \"predictions\".\"entry_price\")))\n        or (\"predictions\".\"status\" = 'lost' and ((\"predictions\".\"direction\" = 'UP' and \"predictions\".\"exit_price\" < \"predictions\".\"entry_price\")\n                                   or (\"predictions\".\"direction\" = 'DOWN' and \"predictions\".\"exit_price\" > \"predictions\".\"entry_price\"))))"
        },
        "predictions_payout_check": {
          "name": "predictions_payout_check",
          "value": "\"predictions\".\"status\" = 'open'\n        or (\"predictions\".\"status\" = 'won' and \"predictions\".\"payout_amount\" = \"predictions\".\"stake\" + (\"predictions\".\"stake\" * \"predictions\".\"payout_bps\") / 10000)\n        or (\"predictions\".\"status\" = 'lost' and \"predictions\".\"payout_amount\" = 0)\n        or (\"predictions\".\"status\" in ('tie', 'void') and \"predictions\".\"payout_amount\" = \"predictions\".\"stake\")"
        },
        "predictions_net_check": {
          "name": "predictions_net_check",
          "value": "(\"predictions\".\"status\" = 'open' and \"predictions\".\"net_result\" is null) or \"predictions\".\"net_result\" = \"predictions\".\"payout_amount\" - \"predictions\".\"stake\""
        },
        "predictions_exit_time_check": {
          "name": "predictions_exit_time_check",
          "value": "\"predictions\".\"exit_received_at\" is null or \"predictions\".\"exit_received_at\" <= \"predictions\".\"expires_at\""
        }
      },
      "isRLSEnabled": false
    },
