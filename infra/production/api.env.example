# Настройки API в production. Скопировать в /opt/updown/api.env и заполнить; файл не попадает в git.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://updown:CHANGE_ME@127.0.0.1:5432/updown
# один экземпляр API: миграции безопасно применять при старте
DB_MIGRATE_ON_BOOT=true
# публичный адрес сайта: проверка Origin у WebSocket
WEB_ORIGIN=https://example.com
COOKIE_SECURE=true
# API за nginx: реальный адрес игрока берётся из X-Forwarded-For
TRUST_PROXY=true
DRAIN_ON_SHUTDOWN=true
# биржевой фид котировок (WebSocket, канал book)
MARKET_WS_URL=wss://feed.example/v2
# почта для кодов входа: SMTP сервиса рассылок, логин и пароль как есть (без кодирования)
SMTP_HOST=smtp.example.com
# 465 - шифрование сразу; если хостинг закрывает 465 и 587 для исходящих, обычно открыт 2525 (STARTTLS)
SMTP_PORT=465
SMTP_USER=login@example.com
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=UpDown <info@example.com>
COMEBACK_AMOUNT=1000
COMEBACK_COOLDOWN_HOURS=12
