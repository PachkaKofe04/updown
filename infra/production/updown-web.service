[Unit]
Description=UpDown web
After=network-online.target updown-api.service
Wants=network-online.target

[Service]
User=updown
WorkingDirectory=/opt/updown/app/apps/web
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
MemoryMax=450M
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
